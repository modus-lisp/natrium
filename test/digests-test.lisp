;;;; test/digests-test.lisp -- SHA-1, RIPEMD-160, SHA3-256: published vectors,
;;;; plus (when ironclad is loadable) a randomized differential against it.
;;;;   sbcl --script test/digests-test.lisp      |   modus --script test/digests-test.lisp
(require :asdf)
(let ((roots (list (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*))
                   (or (uiop:getenv "DEPS") "/home/user/lispdeps/"))))
  (if (fboundp (find-symbol "INITIALIZE-SOURCE-REGISTRY" "ASDF"))
      (funcall (find-symbol "INITIALIZE-SOURCE-REGISTRY" "ASDF")
               `(:source-registry ,@(mapcar (lambda (r) (list :tree r)) roots) :inherit-configuration))
      ;; modus's ASDF: no source registry, so register each .asd directory
      (dolist (r roots)
        (dolist (asd (directory (merge-pathnames "**/*.asd" r)))
          (pushnew (make-pathname :name nil :type nil :defaults asd) asdf:*central-registry* :test #'equal)))))
(asdf:load-system "natrium")
(defvar *fail* 0) (defvar *pass* 0)
(defun hex (v) (format nil "~(~{~2,'0x~}~)" (coerce v 'list)))
(defun bytes (s) (map '(simple-array (unsigned-byte 8) (*)) #'char-code s))
(defun check (name got want)
  (if (string= got want) (incf *pass*)
      (progn (incf *fail*) (format t "~&FAIL ~a~%  got  ~a~%  want ~a~%" name got want))))
(defparameter *million-a* (make-array 1000000 :element-type '(unsigned-byte 8) :initial-element 97))
(dolist (v `(("sha1 empty"  natrium:sha1 "" "da39a3ee5e6b4b0d3255bfef95601890afd80709")
             ("sha1 abc"    natrium:sha1 "abc" "a9993e364706816aba3e25717850c26c9cd0d89d")
             ("sha1 448"    natrium:sha1 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
             ("rmd empty"   natrium:ripemd160 "" "9c1185a5c5e9fc54612808977ee8f548b2258d31")
             ("rmd abc"     natrium:ripemd160 "abc" "8eb208f7e05d987a9b044a8e98c6b087f15a0bfc")
             ("rmd md"      natrium:ripemd160 "message digest" "5d0689ef49d2fae572b881b123a85ffa21595f36")
             ("rmd 448"     natrium:ripemd160 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" "12a053384a9c0c88e405a06c27dcf49ada62eb2b")
             ("md5 empty"   natrium:md5 "" "d41d8cd98f00b204e9800998ecf8427e")
             ("md5 abc"     natrium:md5 "abc" "900150983cd24fb0d6963f7d28e17f72")
             ("md5 md"      natrium:md5 "message digest" "f96b697d7cb7938d525a2f31aaf161d0")
             ("md5 80"      natrium:md5 "12345678901234567890123456789012345678901234567890123456789012345678901234567890" "57edf4a22be3c955ac49da2e2107b67a")
             ("sha3 empty"  natrium:sha3-256 "" "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
             ("sha3 abc"    natrium:sha3-256 "abc" "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
             ("sha3 448"    natrium:sha3-256 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376")))
  (destructuring-bind (name fn msg want) v (check name (hex (funcall fn (bytes msg))) want)))
(check "sha1 1M a"  (hex (natrium:sha1 *million-a*)) "34aa973cd4c4daa4f61eeb2bdbad27316534016f")
;; streaming: the same million a's fed in uneven pieces that straddle block edges,
;; and a range of a NON-simple vector (copied, so START/END must be re-based)
(check "sha1 1M a streamed"
       (hex (let ((s (natrium:sha1-init)) (i 0))
              (loop for n in '(1 63 64 65 127 1000 4095) do
                (natrium:sha1-update s *million-a* i (+ i n)) (incf i n))
              (natrium:sha1-update s *million-a* i)
              (natrium:sha1-final s)))
       "34aa973cd4c4daa4f61eeb2bdbad27316534016f")
(check "sha1 range of an adjustable vector"
       (hex (let ((v (make-array 10 :element-type '(unsigned-byte 8) :adjustable t
                                    :initial-contents (bytes "xxabcxxxxx")))
                  (s (natrium:sha1-init)))
              (natrium:sha1-update s v 2 5) (natrium:sha1-final s)))
       "a9993e364706816aba3e25717850c26c9cd0d89d")
(check "rmd 1M a"   (hex (natrium:ripemd160 *million-a*)) "52783243c1697bdbe16d37f97f68f08325dc1528")
(check "sha3 1M a"  (hex (natrium:sha3-256 *million-a*)) "5c8875ae474a3634ba4fd55ec85bffd661f32aca75c6d699d0cdcb6c115891c1")
(check "hash160"    (hex (natrium:hash160 (bytes "abc"))) "bb1be98c142444d7a56aa3981c3942a978e4dc33")
;; SHAKE256 (FIPS 202): 32 bytes, and 300 -- more than one 136-byte squeeze
(check "shake256 empty 32" (hex (natrium:shake256 (bytes "") 32))
       "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f")
(check "shake256 empty 64" (hex (natrium:shake256 (bytes "") 64))
       "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be")
;; streaming SHA3-256 in pieces across the 136-byte rate, and a copy read part-way
(let ((st (natrium:make-sha3-256-state)) (i 0))
  (loop for n in '(1 135 136 137 271 5000) do (natrium:sha3-update st *million-a* i (+ i n)) (incf i n))
  (let ((fork (natrium:sha3-copy-state st)))
    (check "sha3 copy part-way" (hex (natrium:sha3-final fork))
           (hex (natrium:sha3-256 (subseq *million-a* 0 i)))))
  (natrium:sha3-update st *million-a* i)
  (check "sha3 1M a streamed" (hex (natrium:sha3-final st))
         "5c8875ae474a3634ba4fd55ec85bffd661f32aca75c6d699d0cdcb6c115891c1"))
;; a SHA-1 copy read part-way leaves the original running
(let ((s (natrium:sha1-init)))
  (natrium:sha1-update s (bytes "ab"))
  (let ((fork (natrium:sha1-copy-state s)))
    (check "sha1 copy part-way" (hex (natrium:sha1-final fork)) (hex (natrium:sha1 (bytes "ab")))))
  (natrium:sha1-update s (bytes "c"))
  (check "sha1 original after copy" (hex (natrium:sha1-final s)) "a9993e364706816aba3e25717850c26c9cd0d89d"))
;; HMAC-SHA1 (RFC 2202 cases 1 and 2), PBKDF2-HMAC-SHA1 (RFC 6070)
(check "hmac-sha1 rfc2202 1" (hex (natrium:hmac-sha1 (make-array 20 :element-type '(unsigned-byte 8) :initial-element #x0b) (bytes "Hi There")))
       "b617318655057264e28bc0b6fb378c8ef146be00")
(check "hmac-sha1 rfc2202 2" (hex (natrium:hmac-sha1 (bytes "Jefe") (bytes "what do ya want for nothing?")))
       "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
(dolist (v '((1 "0c60c80f961f0e71f3a9b524af6012062fe037a6") (4096 "4b007901b765489abead49d926f721d065a429c1")))
  (check (format nil "pbkdf2-sha1 rfc6070 c=~d" (first v))
         (hex (natrium:pbkdf2-into :sha1 (bytes "password") (bytes "salt") (first v)
                                   (make-array 20 :element-type '(unsigned-byte 8))))
         (second v)))
;; AES streams (NIST SP 800-38A F.5.1 CTR-AES128, F.3.13 CFB128-AES128), fed in
;; pieces that do not line up with blocks
(defun unhex (h) (let ((v (make-array (/ (length h) 2) :element-type '(unsigned-byte 8))))
                   (dotimes (i (length v) v) (setf (aref v i) (parse-integer h :start (* 2 i) :end (+ 2 (* 2 i)) :radix 16)))))
;; AES keys must be in fixed memory; where gossamer cannot provide it (hosted Modus
;; today), say so rather than abort the digests above.
(handler-case
(let* ((key (gossamer:fixed-copy (unhex "2b7e151628aed2a6abf7158809cf4f3c")))
       (pt "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
       (pieces '(1 15 17 3 28)))
  (natrium:with-aes-key (k key)
    (flet ((run (st) (let ((buf (unhex pt)) (i 0))
                       (dolist (n pieces) (natrium:aes-stream-xor st buf :start i :end (+ i n)) (incf i n))
                       (natrium:aes-stream-xor st buf :start i)
                       (natrium:aes-stream-wipe st)
                       (hex buf))))
      (check "aes-ctr stream sp800-38a"
             (run (natrium:make-aes-ctr-stream k (unhex "f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")))
             "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff5ae4df3edbd5d35e5b4f09020db03eab1e031dda2fbe03d1792170a0f3009cee")
      (let ((ct (run (natrium:make-aes-cfb-stream k (unhex "000102030405060708090a0b0c0d0e0f") :encrypt))))
        (check "aes-cfb stream sp800-38a" ct
               "3b3fd92eb72dad20333449f8e83cfb4ac8a64537a0b3a93fcde3cdad9f1ce58b26751f67a3cbb140b1808cf187a4f4dfc04b05357c5d1c0eeac4c66f9ff7f2e6")
        (let ((st (natrium:make-aes-cfb-stream k (unhex "000102030405060708090a0b0c0d0e0f") :decrypt))
              (buf (unhex ct)) (i 0))
          (dolist (n '(7 9 16 32)) (natrium:aes-stream-xor st buf :start i :end (+ i n)) (incf i n))
          (natrium:aes-stream-wipe st)
          (check "aes-cfb decrypt round trip" (hex buf) pt))))))
  (gossamer:not-fixed (c) (format t "~&SKIP aes streams: no fixed memory here (~a)~%" (type-of c))))
;; differential vs ironclad: every length 0..300 (all padding boundaries) + random
(when (ignore-errors (asdf:load-system "ironclad") t)
 (handler-case
  (let ((rs (make-random-state t)) (n 0))
    (flet ((rnd (len) (let ((v (make-array len :element-type '(unsigned-byte 8))))
                        (dotimes (i len v) (setf (aref v i) (random 256 rs))))))
      (loop for len in (append (loop for i from 0 to 300 collect i) (loop repeat 40 collect (random 5000 rs)))
            do (let ((m (rnd len)))
                 (incf n)
                 (dolist (pair '((natrium:sha1 . :sha1) (natrium:md5 . :md5) (natrium:ripemd160 . :ripemd-160) (natrium:sha3-256 . :sha3/256)))
                   (check (format nil "~a len ~d" (car pair) len)
                          (hex (funcall (car pair) m))
                          (hex (funcall (intern "DIGEST-SEQUENCE" "IRONCLAD") (cdr pair) m)))))))
    (format t "~&;; differential vs ironclad: ~d messages x 4 digests~%" n))
  (error (c) (format t "~&;; differential skipped: ironclad unusable here (~a)~%" (type-of c)))))
(format t "~&digests: ~d passed, ~d failed~%" *pass* *fail*)
(uiop:quit (if (zerop *fail*) 0 1))
