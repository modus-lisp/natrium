;;;; test/digests-test.lisp -- SHA-1, RIPEMD-160, SHA3-256: published vectors,
;;;; plus (when ironclad is loadable) a randomized differential against it.
;;;;   sbcl --script test/digests-test.lisp      |   modus --script test/digests-test.lisp
(require :asdf)
(let ((roots (list (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*))
                   (or (uiop:getenv "DEPS") "/home/user/lispdeps/"))))
  (if (fboundp (find-symbol "INITIALIZE-SOURCE-REGISTRY" "ASDF"))
      (funcall (find-symbol "INITIALIZE-SOURCE-REGISTRY" "ASDF")
               `(:source-registry ,@(mapcar (lambda (r) (list :tree r)) roots) :inherit-configuration))
      ;; modus's ASDF: no source registry, so register each .asd directory
      (dolist (r roots)
        (dolist (asd (directory (merge-pathnames "**/*.asd" r)))
          (pushnew (make-pathname :name nil :type nil :defaults asd) asdf:*central-registry* :test #'equal)))))
(asdf:load-system "natrium")
(defvar *fail* 0) (defvar *pass* 0)
(defun hex (v) (format nil "~(~{~2,'0x~}~)" (coerce v 'list)))
(defun bytes (s) (map '(simple-array (unsigned-byte 8) (*)) #'char-code s))
(defun check (name got want)
  (if (string= got want) (incf *pass*)
      (progn (incf *fail*) (format t "~&FAIL ~a~%  got  ~a~%  want ~a~%" name got want))))
(defparameter *million-a* (make-array 1000000 :element-type '(unsigned-byte 8) :initial-element 97))
(dolist (v `(("sha1 empty"  natrium:sha1 "" "da39a3ee5e6b4b0d3255bfef95601890afd80709")
             ("sha1 abc"    natrium:sha1 "abc" "a9993e364706816aba3e25717850c26c9cd0d89d")
             ("sha1 448"    natrium:sha1 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
             ("rmd empty"   natrium:ripemd160 "" "9c1185a5c5e9fc54612808977ee8f548b2258d31")
             ("rmd abc"     natrium:ripemd160 "abc" "8eb208f7e05d987a9b044a8e98c6b087f15a0bfc")
             ("rmd md"      natrium:ripemd160 "message digest" "5d0689ef49d2fae572b881b123a85ffa21595f36")
             ("rmd 448"     natrium:ripemd160 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" "12a053384a9c0c88e405a06c27dcf49ada62eb2b")
             ("sha3 empty"  natrium:sha3-256 "" "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
             ("sha3 abc"    natrium:sha3-256 "abc" "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
             ("sha3 448"    natrium:sha3-256 "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376")))
  (destructuring-bind (name fn msg want) v (check name (hex (funcall fn (bytes msg))) want)))
(check "sha1 1M a"  (hex (natrium:sha1 *million-a*)) "34aa973cd4c4daa4f61eeb2bdbad27316534016f")
;; streaming: the same million a's fed in uneven pieces that straddle block edges,
;; and a range of a NON-simple vector (copied, so START/END must be re-based)
(check "sha1 1M a streamed"
       (hex (let ((s (natrium:sha1-init)) (i 0))
              (loop for n in '(1 63 64 65 127 1000 4095) do
                (natrium:sha1-update s *million-a* i (+ i n)) (incf i n))
              (natrium:sha1-update s *million-a* i)
              (natrium:sha1-final s)))
       "34aa973cd4c4daa4f61eeb2bdbad27316534016f")
(check "sha1 range of an adjustable vector"
       (hex (let ((v (make-array 10 :element-type '(unsigned-byte 8) :adjustable t
                                    :initial-contents (bytes "xxabcxxxxx")))
                  (s (natrium:sha1-init)))
              (natrium:sha1-update s v 2 5) (natrium:sha1-final s)))
       "a9993e364706816aba3e25717850c26c9cd0d89d")
(check "rmd 1M a"   (hex (natrium:ripemd160 *million-a*)) "52783243c1697bdbe16d37f97f68f08325dc1528")
(check "sha3 1M a"  (hex (natrium:sha3-256 *million-a*)) "5c8875ae474a3634ba4fd55ec85bffd661f32aca75c6d699d0cdcb6c115891c1")
(check "hash160"    (hex (natrium:hash160 (bytes "abc"))) "bb1be98c142444d7a56aa3981c3942a978e4dc33")
;; differential vs ironclad: every length 0..300 (all padding boundaries) + random
(when (ignore-errors (asdf:load-system "ironclad") t)
 (handler-case
  (let ((rs (make-random-state t)) (n 0))
    (flet ((rnd (len) (let ((v (make-array len :element-type '(unsigned-byte 8))))
                        (dotimes (i len v) (setf (aref v i) (random 256 rs))))))
      (loop for len in (append (loop for i from 0 to 300 collect i) (loop repeat 40 collect (random 5000 rs)))
            do (let ((m (rnd len)))
                 (incf n)
                 (dolist (pair '((natrium:sha1 . :sha1) (natrium:ripemd160 . :ripemd-160) (natrium:sha3-256 . :sha3/256)))
                   (check (format nil "~a len ~d" (car pair) len)
                          (hex (funcall (car pair) m))
                          (hex (funcall (intern "DIGEST-SEQUENCE" "IRONCLAD") (cdr pair) m)))))))
    (format t "~&;; differential vs ironclad: ~d messages x 3 digests~%" n))
  (error (c) (format t "~&;; differential skipped: ironclad unusable here (~a)~%" (type-of c)))))
(format t "~&digests: ~d passed, ~d failed~%" *pass* *fail*)
(uiop:quit (if (zerop *fail*) 0 1))
